{
    "env": {
        "arduinoAvr": "C:/Users/lagis/AppData/Local/Arduino15/packages/arduino/hardware/avr/1.8.7",
        "avrGcc": "C:/Users/lagis/AppData/Local/Arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7"
    },
    "configurations": [
        {
            "name": "Arduino Uno",
            "includePath": [
                "${workspaceFolder}/**",
                "${arduinoAvr}/cores/arduino",
                "${arduinoAvr}/variants/standard",
                "${arduinoAvr}/libraries/**",
                "C:/Users/lagis/Documents/Arduino/libraries/**",
                "${avrGcc}/avr/include",
                "${avrGcc}/lib/gcc/avr/7.3.0/include"
            ],
            "forcedInclude": [
                "${arduinoAvr}/cores/arduino/Arduino.h"
            ],
            "defines": [
                "ARDUINO=10819",
                "ARDUINO_AVR_UNO",
                "ARDUINO_ARCH_AVR",
                "__AVR_ATmega328P__",
                "F_CPU=16000000L"
            ],
            "compilerPath": "${avrGcc}/bin/avr-g++.exe",
            "compilerArgs": ["-mmcu=atmega328p"],
            "cStandard": "c11",
            "cppStandard": "c++11",
            "intelliSenseMode": "gcc-x86"
        }
    ],
    "version": 4
}
